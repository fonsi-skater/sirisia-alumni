generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  organizer
  treasurer
  admin
}

enum ContributionStatus {
  pending
  matched
  unmatched
}

model Member {
  id                String   @id @default(uuid())
  fullName          String
  phoneNumber       String   @unique
  classYear         String?
  role              Role     @default(member)
  tag               String?
  occupation        String?
  profilePictureUrl String?
  createdAt         DateTime @default(now())

  contributions Contribution[]
  rsvps         Rsvp[]
}

model Target {
  id            String   @id @default(uuid())
  title         String
  goalAmount    Decimal
  currentTotal  Decimal  @default(0)
  deadline      DateTime?
  createdAt     DateTime @default(now())

  contributions Contribution[]
}

model Contribution {
  id            String             @id @default(uuid())
  member        Member?            @relation(fields: [memberId], references: [id])
  memberId      String?
  target        Target             @relation(fields: [targetId], references: [id])
  targetId      String
  amount        Decimal
  mpesaReceipt  String?            @unique
  payerPhone    String
  status        ContributionStatus @default(pending)
  paidAt        DateTime           @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  eventDate   DateTime
  location    String?
  description String?
  createdAt   DateTime @default(now())

  rsvps  Rsvp[]
  photos Photo[]
}

model Rsvp {
  id       String  @id @default(uuid())
  event    Event   @relation(fields: [eventId], references: [id])
  eventId  String
  member   Member  @relation(fields: [memberId], references: [id])
  memberId String
  attending Boolean @default(true)

  @@unique([eventId, memberId])
}

model Photo {
  id       String  @id @default(uuid())
  event    Event   @relation(fields: [eventId], references: [id])
  eventId  String
  imageUrl String
  caption  String?
}

model Post {
  id         String   @id @default(uuid())
  authorName String
  topic      String
  body       String
  createdAt  DateTime @default(now())
}

model Meeting {
  id        String   @id @default(uuid())
  title     String
  dateTime  DateTime
  joinUrl   String
  agenda    String?
  createdAt DateTime @default(now())
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}
